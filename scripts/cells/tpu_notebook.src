# --- compression, measured from the parameter counts actually recorded above
comp_rows = []
for mid in MODEL_IDS:
    short = mid.split("/")[-1]
    base = results_df[
        (results_df.operator == "baseline") & (results_df.model_short == short)
    ]
    if not len(base):
